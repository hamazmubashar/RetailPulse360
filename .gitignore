# RetailPulse 360 — .gitignore

# Raw datasets — too large for git, and re-downloadable via docs/DATA_SOURCES.md
datasets/raw/

# Environment / secrets
.env
.env.local

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.DS_Store

# Streamlit
.streamlit/secrets.toml

# Large model artifacts get Git LFS, not a blanket ignore —
# tracked explicitly via .gitattributes instead

# IDE
.vscode/
.idea/